+            consume(
+                self.keys
+                    .get(&offset)
+                    .expect("R36.8E: retained key must exist"),
+            );
+        } else {
+            consume(&key);
+        }
+    }
+
+    pub fn retained_keys(&self) -> usize {
+        self.keys.len()
+    }
+
+    pub fn capacity(&self) -> usize {
+        self.retained_offsets.len()
+    }
+}
